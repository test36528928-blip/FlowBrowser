<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlowBrowser</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <ApplicationIcon>Assets\FlowBrowser.ico</ApplicationIcon>
    <RootNamespace>FlowBrowser</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\FlowBrowser.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- CEF tabanlı Chromium motoru -->
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="156.0.300" />
    </ItemGroup>
</Project>
