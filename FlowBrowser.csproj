<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlowBrowser</AssemblyName>
    <ApplicationIcon>Assets\FlowBrowser.ico</ApplicationIcon>
    <RootNamespace>FlowBrowser</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\FlowBrowser.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
