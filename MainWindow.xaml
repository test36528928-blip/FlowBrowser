<Window x:Class="FlowBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FlowBrowser" Width="1280" Height="820" MinWidth="850" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        Icon="Assets/FlowBrowser.ico" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" StateChanged="Window_StateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="43" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="43"/><RowDefinition Height="56"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="24"/>
    </Grid.RowDefinitions>

    <!-- Standard Windows title bar stays native and visible. Tabs and the + button sit directly beneath it. -->
    <Border Grid.Row="0" Background="#E8EDF5" Padding="8,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <!-- Reserve the native Windows caption-button area on the right. -->
          <ColumnDefinition Width="145" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TabsStrip" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8,8,0,0" Margin="2,2,0,0" MinWidth="120" MaxWidth="230" Padding="3">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#E3E9F2"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#FFFFFF"/></DataTrigger></Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" FontSize="15" Padding="5,1" Margin="1,0,0,0" ToolTip="Sekmeyi kapat" Click="CloseTab_Click"
                            />
                    <Button Content="{Binding Title}" Tag="{Binding}" Click="SelectTab_Click" Padding="8,6" FontSize="12" HorizontalContentAlignment="Left" ToolTip="Sekmeye geç"
                            />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Column="1" Content="＋" FontSize="19" Width="34" Height="32" Margin="5,0,0,0"
                ToolTip="Yeni sekme (Ctrl+T)" Click="NewTab_Click"/>
        <!-- Custom caption controls: visible buttons with real WPF window actions. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeWindowButton" Content="—" Width="46" FontSize="15" Background="Transparent" BorderThickness="0"
                  Foreground="#243044" ToolTip="Küçült" Click="MinimizeWindow_Click">
            <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#243044"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D6DCE5"/></Trigger></Style.Triggers></Style></Button.Style>
          </Button>
          <Button x:Name="MaximizeWindowButton" Content="□" Width="46" FontSize="15" Background="Transparent" BorderThickness="0"
                  Foreground="#243044" ToolTip="Büyüt" Click="MaximizeRestoreWindow_Click">
            <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#243044"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D6DCE5"/></Trigger></Style.Triggers></Style></Button.Style>
          </Button>
          <Button Content="×" Width="48" FontSize="19" Background="Transparent" BorderThickness="0"
                  Foreground="#243044" ToolTip="Kapat" Click="CloseWindow_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#243044" />
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123" /><Setter Property="Foreground" Value="White" /></Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="‹" FontSize="23" Padding="9,1" ToolTip="Geri" Click="Back_Click"/>
          <Button Content="›" FontSize="23" Padding="9,1" ToolTip="İleri" Click="Forward_Click"/>
          <Button Content="↻" FontSize="18" Padding="10,4" ToolTip="Yenile (Ctrl+R)" Click="Reload_Click"/>
          <Button Content="⌂" FontSize="19" Padding="10,4" ToolTip="Ana sayfa" Click="Home_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="☆" FontSize="19" Padding="9,4" ToolTip="Yer imlerine ekle" Click="Bookmark_Click"/>
          <Button Content="⋮" FontSize="23" Padding="10,0" ToolTip="FlowBrowser menüsü" Click="MoreMenu_Click"/>
        </StackPanel>
        <Border Background="#F2F5FA" BorderBrush="#E0E7F1" BorderThickness="1" CornerRadius="18" Margin="10,0" Padding="11,0">
          <DockPanel>
            <TextBlock Text="⌕" Foreground="{StaticResource MutedBrush}" FontSize="20" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox x:Name="AddressBox" ToolTip="Adres veya Google araması yazın" KeyDown="AddressBox_KeyDown"/>
          </DockPanel>
        </Border>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="9,2">
      <DockPanel>
        <TextBlock Text="Yer imleri" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="BookmarkBar" ItemsSource="{Binding Bookmarks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding}" Padding="9,4" Margin="0,0,4,0" FontSize="11" Click="OpenBookmark_Click" ToolTip="{Binding Url}"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Margin="8,7,8,5" Background="#FFFFFF" CornerRadius="7" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
      <ContentControl x:Name="BrowserSurface" Content="{Binding ActiveTab.View}"/>
    </Border>

    <Border Grid.Row="4" Background="#E8EDF5" Padding="12,0">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Hazır" Foreground="{StaticResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
        <TextBlock Text="Microsoft Edge WebView2" Foreground="{StaticResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
